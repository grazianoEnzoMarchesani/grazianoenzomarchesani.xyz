{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/lib/*": [
        "src/vendor/bklit/lib/*"
      ],
      "@/components/*": [
        "src/vendor/bklit/components/*"
      ]
    }
  }
}
