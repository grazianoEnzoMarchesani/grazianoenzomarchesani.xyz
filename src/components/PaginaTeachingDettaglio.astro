---
import { render, type CollectionEntry } from 'astro:content';
import { getAdjacentFieldMarker } from '../data/fields-content';
import FieldArticleLayout from './FieldArticleLayout.astro';
import ElencoTag from './ElencoTag.astro';
import { miniatureFigure } from '../lib/miniature-figure';
import { type Lingua, linguaDefault, t } from '../i18n/testi';

interface Props {
  entry: CollectionEntry<'teaching'> & { chiave: string; tradotto?: boolean };
  lingua?: Lingua;
}

const { entry, lingua = (Astro.currentLocale as Lingua) || linguaDefault } = Astro.props;
const currentId = `teaching/${entry.chiave}`;
const { next, prev } = await getAdjacentFieldMarker(currentId, lingua);
const { Content, headings } = await render(entry);
const figure = await miniatureFigure(entry);

const { tipo, anni, attivo, istituzione, luogo, titolo, sommario } = entry.data;
const kicker =
  `${t('fields.teaching', lingua)} · ${tipo} · ${anni}` +
  (attivo ? ` · ${lingua === 'it' ? 'in corso' : 'active'}` : '');
---

<FieldArticleLayout
  categoria="teaching"
  lingua={lingua}
  titolo={titolo}
  sommario={sommario}
  kicker={kicker}
  tradotto={entry.tradotto}
  currentId={currentId}
  next={next}
  prev={prev}
  headings={headings}
  figure={figure}
>
  <ElencoTag slot="tag" id={currentId} lingua={lingua} grezzi={[istituzione, luogo]} />

  <Content />
</FieldArticleLayout>
