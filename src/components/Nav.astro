---
import { getSezioni } from '../data/home';
import { type Lingua, urlPerLingua, t } from '../i18n/testi';
import rawLogo from '../assets/logo.svg?raw';
import SearchModal from './SearchModal.astro';

interface Props {
	lingua?: Lingua;
}

const lingua: Lingua = Astro.props.lingua || (Astro.currentLocale as Lingua) || (Astro.url.pathname.startsWith('/it') ? 'it' : 'en');
const sezioni = getSezioni(lingua);
const homeHref = lingua === 'it' ? '/it' : '/';

const logoMarkup = rawLogo
	.replace(/<\?xml[^>]*\?>\s*/, '')
	.replace(/<!DOCTYPE[^>]*>\s*/, '')
	.replace('<svg ', '<svg class="h-8 sm:h-12 w-auto transition-all" ')
	.replace(' width="100%" height="100%"', '');
---

<nav class="fixed inset-x-0 top-0 z-30 px-4 py-3 sm:px-10 sm:py-4 text-xs uppercase tracking-widest">
	<div class="flex items-center justify-between gap-x-3 sm:gap-x-6">
		<a href={homeHref} aria-label="Graziano Enzo Marchesani - Home" class="hover:opacity-60 transition-opacity flex items-center shrink-0" set:html={logoMarkup} />
		
		<div class="flex items-center gap-x-2 sm:gap-x-4">
			{/* Menu Desktop */}
			<ul class="hidden md:flex items-center gap-x-5 rounded-full bg-paper/60 px-4 py-1 backdrop-blur-sm">
				{sezioni.map((s) => (
					<li><a href={s.href} class="hover:opacity-60 transition-opacity">{s.titolo}</a></li>
				))}
			</ul>

			{/* Search Button */}
			<button
				id="nav-search-btn"
				type="button"
				class="flex items-center gap-1.5 rounded-full bg-paper/60 px-2.5 py-1 text-[10px] tracking-normal backdrop-blur-sm text-ink/70 hover:text-ink hover:bg-paper transition-all cursor-pointer"
				aria-label={t('search.apri', lingua)}
			>
				<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
				</svg>
				<span id="nav-search-shortcut" class="hidden sm:inline font-mono opacity-60">⌘K</span>
			</button>

			{/* Language Switcher */}
			<div class="flex items-center gap-1 rounded-full bg-paper/60 px-2 py-0.5 text-[10px] tracking-normal backdrop-blur-sm" aria-label={t('nav.selettoreLingua', lingua)}>
				<a
					href={urlPerLingua(Astro.url.pathname, 'en')}
					class:list={[
						'rounded px-1.5 py-0.5 transition-colors',
						lingua === 'en' ? 'bg-ink text-paper font-semibold' : 'text-ink/60 hover:text-ink',
					]}
					aria-current={lingua === 'en' ? 'page' : undefined}
				>
					EN
				</a>
				<span class="opacity-30">/</span>
				<a
					href={urlPerLingua(Astro.url.pathname, 'it')}
					class:list={[
						'rounded px-1.5 py-0.5 transition-colors',
						lingua === 'it' ? 'bg-ink text-paper font-semibold' : 'text-ink/60 hover:text-ink',
					]}
					aria-current={lingua === 'it' ? 'page' : undefined}
				>
					IT
				</a>
			</div>

			{/* Mobile Menu Toggle Button */}
			<button
				id="nav-mobile-toggle"
				type="button"
				class="md:hidden flex items-center gap-1.5 rounded-full bg-paper/60 px-2.5 py-1 text-[11px] font-mono tracking-wider backdrop-blur-sm text-ink/80 hover:text-ink hover:bg-paper transition-all cursor-pointer"
				aria-expanded="false"
				aria-controls="nav-mobile-menu"
				aria-label={t('nav.menu', lingua)}
			>
				<svg id="nav-mobile-icon-bars" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
				</svg>
				<svg id="nav-mobile-icon-close" class="h-3.5 w-3.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
				<span id="nav-mobile-toggle-label">{t('nav.menu', lingua)}</span>
			</button>
		</div>
	</div>

	{/* Mobile Dropdown Card */}
	<div
		id="nav-mobile-menu"
		class="md:hidden absolute left-4 right-4 top-full mt-2 overflow-hidden rounded-2xl border border-ink/15 bg-paper/95 p-4 shadow-2xl backdrop-blur-md transition-all duration-200 ease-out origin-top opacity-0 pointer-events-none -translate-y-2 scale-[0.98]"
		aria-hidden="true"
	>
		<ul class="flex flex-col divide-y divide-ink/10">
			{sezioni.map((s) => (
				<li>
					<a
						href={s.href}
						class="flex items-center justify-between py-3 text-xs uppercase tracking-widest text-ink/80 hover:text-ink transition-colors"
					>
						<span>{s.titolo}</span>
						<span class="text-ink/40 font-mono text-xs">↗</span>
					</a>
				</li>
			))}
		</ul>
	</div>
</nav>

<SearchModal lingua={lingua} />

<script>
	const aggiornaScorciatoia = () => {
		const isMac = typeof navigator !== 'undefined' && /(Mac|iPhone|iPod|iPad)/i.test(navigator.userAgent || navigator.platform || '');
		const shortcutEl = document.getElementById('nav-search-shortcut');
		if (shortcutEl && !isMac) {
			shortcutEl.textContent = 'Ctrl K';
		}
	};

	const apriMenuNav = () => {
		const toggleBtn = document.getElementById('nav-mobile-toggle');
		const menu = document.getElementById('nav-mobile-menu');
		const iconBars = document.getElementById('nav-mobile-icon-bars');
		const iconClose = document.getElementById('nav-mobile-icon-close');
		if (!menu || !toggleBtn) return;

		menu.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-2', 'scale-[0.98]');
		menu.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0', 'scale-100');
		toggleBtn.setAttribute('aria-expanded', 'true');
		menu.setAttribute('aria-hidden', 'false');
		iconBars?.classList.add('hidden');
		iconClose?.classList.remove('hidden');
	};

	const chiudiMenuNav = () => {
		const toggleBtn = document.getElementById('nav-mobile-toggle');
		const menu = document.getElementById('nav-mobile-menu');
		const iconBars = document.getElementById('nav-mobile-icon-bars');
		const iconClose = document.getElementById('nav-mobile-icon-close');
		if (!menu || !toggleBtn) return;

		menu.classList.add('opacity-0', 'pointer-events-none', '-translate-y-2', 'scale-[0.98]');
		menu.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0', 'scale-100');
		toggleBtn.setAttribute('aria-expanded', 'false');
		menu.setAttribute('aria-hidden', 'true');
		iconBars?.classList.remove('hidden');
		iconClose?.classList.add('hidden');
	};

	if (!(window as any).__navMobileHandlersAttached) {
		(window as any).__navMobileHandlersAttached = true;

		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement | null;
			if (!target) return;

			// Toggle mobile menu
			const toggleBtn = target.closest('#nav-mobile-toggle');
			if (toggleBtn) {
				e.preventDefault();
				e.stopPropagation();
				const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
				if (isOpen) chiudiMenuNav();
				else apriMenuNav();
				return;
			}

			// Click su link all'interno del menu mobile
			if (target.closest('#nav-mobile-menu a')) {
				chiudiMenuNav();
				return;
			}

			// Click su pulsante di ricerca
			if (target.closest('#nav-search-btn')) {
				document.dispatchEvent(new CustomEvent('open-search'));
				return;
			}

			// Click esterno per chiudere
			if (!target.closest('#nav-mobile-menu')) {
				const menu = document.getElementById('nav-mobile-menu');
				if (menu && !menu.classList.contains('opacity-0')) {
					chiudiMenuNav();
				}
			}
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				chiudiMenuNav();
			}
		});
	}

	aggiornaScorciatoia();
	document.addEventListener('astro:page-load', () => {
		aggiornaScorciatoia();
		chiudiMenuNav();
	});
</script>
