---
import { sezioni } from '../data/home';
import rawLogo from '../assets/logo.svg?raw';

const logoMarkup = rawLogo
	.replace(/<\?xml[^>]*\?>\s*/, '')
	.replace(/<!DOCTYPE[^>]*>\s*/, '')
	.replace('<svg ', '<svg class="h-12 w-auto" ')
	.replace(' width="100%" height="100%"', '');
---

<nav class="fixed inset-x-0 top-0 z-20 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-4 text-xs uppercase tracking-widest sm:px-10">
	<a href="/" aria-label="Graziano Enzo Marchesani - Home" class="hover:opacity-60 transition-opacity flex items-center" set:html={logoMarkup} />
	<ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
		{sezioni.map((s) => (
			<li><a href={s.href} class="hover:opacity-60 transition-opacity">{s.titolo}</a></li>
		))}
	</ul>
</nav>
