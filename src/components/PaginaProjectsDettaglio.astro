---
import { render, type CollectionEntry } from 'astro:content';
import { getAdjacentFieldMarker } from '../data/fields-content';
import FieldArticleLayout from './FieldArticleLayout.astro';
import ElencoTag from './ElencoTag.astro';
import { miniatureFigure } from '../lib/miniature-figure';
import { type Lingua, linguaDefault, t } from '../i18n/testi';

interface Props {
  entry: CollectionEntry<'projects'> & { chiave: string; tradotto?: boolean };
  lingua?: Lingua;
}

const { entry, lingua = (Astro.currentLocale as Lingua) || linguaDefault } = Astro.props;
const currentId = `projects/${entry.chiave}`;
const { next, prev } = await getAdjacentFieldMarker(currentId, lingua);
const { Content, headings } = await render(entry);
const figure = await miniatureFigure(entry);

const { titolo, anni, luogo, ruolo, tipo, esito, url, sommario } = entry.data;
const kicker = `${t('fields.projects', lingua)} · ${tipo} · ${anni}`;
---

<FieldArticleLayout
  categoria="projects"
  lingua={lingua}
  titolo={titolo}
  sommario={sommario}
  kicker={kicker}
  tradotto={entry.tradotto}
  currentId={currentId}
  next={next}
  prev={prev}
  headings={headings}
  figure={figure}
>
  <ElencoTag slot="tag" id={currentId} lingua={lingua} grezzi={[luogo, ruolo]} />

  <Content />

  {(esito || url) && (
    <ul slot="meta" class="mt-10 space-y-2 text-sm">
      {esito && <li class="opacity-70">{t('fields.esito', lingua)}: {esito}</li>}
      {url && (
        <li>
          <a href={url} class="underline hover:opacity-60" target="_blank" rel="noopener noreferrer">
            {t('fields.sito', lingua)}
          </a>
        </li>
      )}
    </ul>
  )}
</FieldArticleLayout>
