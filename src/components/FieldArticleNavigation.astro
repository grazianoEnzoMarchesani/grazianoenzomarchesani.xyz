---
import type { FieldMarker } from '../data/fields';
import { type Lingua, linguaDefault, t } from '../i18n/testi';

interface Props {
	currentId: string;
	next?: FieldMarker;
	prev?: FieldMarker;
	lingua?: Lingua;
}

const { currentId, next, lingua = (Astro.currentLocale as Lingua) || linguaDefault } = Astro.props;
const isIt = lingua === 'it';
const fieldsUrl = isIt ? '/it/fields' : '/fields';
const nextUrl = next ? (isIt ? `/it/fields/${next.id}` : `/fields/${next.id}`) : '';
---

<div id="overscroll-root" data-current-id={currentId} data-fields-url={fieldsUrl} data-next-url={nextUrl} data-next-title={next?.title ?? ''}>
	<!-- Indicatori overscroll (desktop): opacita' guidata dall'accumulo di scroll -->
	<span id="overscroll-arrow-top" aria-hidden="true" class="pointer-events-none fixed left-1/2 -translate-x-1/2 top-20 sm:top-28 z-40 text-[28px] leading-none opacity-0">↑</span>
	{next && (
		<span id="overscroll-arrow-bottom" aria-hidden="true" class="pointer-events-none fixed left-1/2 -translate-x-1/2 bottom-20 sm:bottom-28 z-40 text-[28px] leading-none opacity-0">↓</span>
	)}

	<!-- Bottom manual link / info -->
	<div class="mt-14 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-t border-ink/10 pt-6">
		<button
			id="back-to-fields-btn"
			type="button"
			class="inline-block text-left text-sm uppercase tracking-widest underline hover:opacity-60 cursor-pointer"
		>
			← {t('fields.indietro', lingua)}
		</button>

		{next && (
			<a
				id="next-article-link"
				href={nextUrl}
				class="inline-block text-left sm:text-right text-sm tracking-wide opacity-80 hover:opacity-100 group"
			>
				<span class="block text-xs uppercase tracking-widest opacity-60">{t('fields.successivo', lingua)} ↓</span>
				<span class="underline group-hover:opacity-70">{next.title}</span>
			</a>
		)}
	</div>
</div>

<script>
	import { gsap } from 'gsap';
	import { navigate } from 'astro:transitions/client';

	let currentCleanup: (() => void) | null = null;

	function setup() {
		// Pulizia istanza precedente se presente
		if (currentCleanup) {
			currentCleanup();
			currentCleanup = null;
		}

		const root = document.getElementById('overscroll-root');
		if (!root) return;

		const currentId = root.getAttribute('data-current-id') ?? '';
		const fieldsUrl = root.getAttribute('data-fields-url') ?? '/fields';
		const nextUrl = root.getAttribute('data-next-url') ?? '';
		const backBtn = document.getElementById('back-to-fields-btn');
		const nextLink = document.getElementById('next-article-link');

		if (currentId) {
			sessionStorage.setItem('fields-target-marker', currentId);
		}

		let isNavigating = false;

		async function goBackToFields() {
			if (isNavigating) return;
			isNavigating = true;
			if (currentId) {
				sessionStorage.setItem('fields-target-marker', currentId);
			}
			const overlay = document.getElementById('field-transition-overlay');
			if (overlay) {
				await gsap.to(overlay, { opacity: 1, duration: 0.3, ease: 'power1.in' });
			}
			navigate(fieldsUrl);
		}

		async function goToNext() {
			if (isNavigating || !nextUrl) return;
			isNavigating = true;
			// Slide transition: animate main upward
			const main = document.querySelector('main');
			if (main) {
				await gsap.to(main, {
					y: -80,
					opacity: 0,
					duration: 0.35,
					ease: 'power2.in',
				});
			}
			navigate(nextUrl);
		}

		backBtn?.addEventListener('click', goBackToFields);
		nextLink?.addEventListener('click', (e) => {
			e.preventDefault();
			goToNext();
		});

		// Overscroll serendipità (desktop wheel/trackpad)
		const THRESHOLD = 2000;
		const arrowTop = document.getElementById('overscroll-arrow-top');
		const arrowBottom = document.getElementById('overscroll-arrow-bottom');
		let pullTop = 0;
		let pullBottom = 0;
		let quietTimer = 0;
		let lastFreeScroll = 0;

		function paint(el: HTMLElement | null, pull: number) {
			if (!el) return;
			// nessuna transizione mentre carica (deve seguire il dito), animata al rilascio
			el.style.transition = pull === 0 ? 'opacity .3s' : 'none';
			el.style.opacity = pull === 0 ? '0' : String(0.15 + 0.85 * Math.min(1, pull / THRESHOLD));
		}

		function release() {
			pullTop = 0;
			pullBottom = 0;
			paint(arrowTop, 0);
			paint(arrowBottom, 0);
		}

		function handleWheel(e: WheelEvent) {
			if (isNavigating) return;
			// Guardia di sicurezza: verificare che siamo ancora sull'articolo
			if (!document.getElementById('overscroll-root')) {
				if (currentCleanup) {
					currentCleanup();
					currentCleanup = null;
				}
				return;
			}

			const scrollTop = window.scrollY || document.documentElement.scrollTop;
			const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
			const atTop = scrollTop <= 1;
			const atBottom = scrollTop >= maxScroll - 2;
			const now = e.timeStamp;

			if (!atTop && !atBottom) lastFreeScroll = now;
			// ponytail: 200ms di quiete al bordo per scartare l'inerzia del trackpad;
			// se su qualche device l'inerzia dura di piu', alzare la costante.
			const gestureStartedAtEdge = now - lastFreeScroll > 200;

			pullTop = atTop && e.deltaY < 0 && gestureStartedAtEdge ? pullTop - e.deltaY : 0;
			pullBottom = nextUrl && atBottom && e.deltaY > 0 && gestureStartedAtEdge ? pullBottom + e.deltaY : 0;

			paint(arrowTop, pullTop);
			paint(arrowBottom, pullBottom);

			clearTimeout(quietTimer);
			quietTimer = window.setTimeout(release, 400);

			if (pullTop >= THRESHOLD) {
				release();
				goBackToFields();
			} else if (pullBottom >= THRESHOLD) {
				release();
				goToNext();
			}
		}

		window.addEventListener('wheel', handleWheel, { passive: true });

		currentCleanup = () => {
			window.removeEventListener('wheel', handleWheel);
			clearTimeout(quietTimer);
		};

		// Rimuove il listener prima di cambiare pagina tramite View Transitions
		document.addEventListener('astro:before-swap', () => {
			if (currentCleanup) {
				currentCleanup();
				currentCleanup = null;
			}
		}, { once: true });

		// Fade out overlay on page entry
		const overlay = document.getElementById('field-transition-overlay');
		if (overlay) {
			gsap.to(overlay, { opacity: 0, duration: 0.35, ease: 'power1.out' });
		}
	}

	document.addEventListener('astro:page-load', setup);
</script>
