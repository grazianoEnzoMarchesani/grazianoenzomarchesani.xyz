---
import type { FieldMarker } from '../data/fields';
import { type Lingua, linguaDefault, t } from '../i18n/testi';

interface Props {
	currentId: string;
	next?: FieldMarker;
	prev?: FieldMarker;
	lingua?: Lingua;
}

const { currentId, next, lingua = (Astro.currentLocale as Lingua) || linguaDefault } = Astro.props;
const isIt = lingua === 'it';
const fieldsUrl = isIt ? '/it/fields' : '/fields';
const nextUrl = next ? (isIt ? `/it/fields/${next.id}` : `/fields/${next.id}`) : '';
---

<div id="overscroll-root" data-current-id={currentId} data-fields-url={fieldsUrl} data-next-url={nextUrl} data-next-title={next?.title ?? ''}>
	<!-- Pull to return top indicator -->
	<div
		id="pull-top-indicator"
		class="pointer-events-none fixed top-16 inset-x-0 z-30 flex justify-center opacity-0 transition-all duration-150 transform -translate-y-2"
		aria-hidden="true"
	>
		<span class="rounded-full border border-ink/20 bg-paper/95 px-4 py-1.5 text-xs uppercase tracking-widest text-ink shadow-sm backdrop-blur-sm">
			{isIt ? '↑ Rilascia per tornare agli Ambiti' : '↑ Release to return to Fields'}
		</span>
	</div>

	<!-- Bottom manual link / info -->
	<div class="mt-14 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-t border-ink/10 pt-6">
		<button
			id="back-to-fields-btn"
			type="button"
			class="inline-block text-left text-sm uppercase tracking-widest underline hover:opacity-60 cursor-pointer"
		>
			← {t('fields.indietro', lingua)}
		</button>

		{next && (
			<a
				id="next-article-link"
				href={nextUrl}
				class="inline-block text-left sm:text-right text-sm tracking-wide opacity-80 hover:opacity-100 group"
			>
				<span class="block text-xs uppercase tracking-widest opacity-60">{t('fields.successivo', lingua)} ↓</span>
				<span class="underline group-hover:opacity-70">{next.title}</span>
			</a>
		)}
	</div>

	<!-- Pull to next bottom indicator -->
	{next && (
		<div
			id="pull-bottom-indicator"
			class="pointer-events-none fixed bottom-10 inset-x-0 z-30 flex justify-center opacity-0 transition-all duration-150 transform translate-y-2"
			aria-hidden="true"
		>
			<span class="rounded-full border border-ink/20 bg-paper/95 px-4 py-1.5 text-xs uppercase tracking-widest text-ink shadow-sm backdrop-blur-sm">
				{isIt ? `↓ Rilascia per il successivo: ${next.title}` : `↓ Release for next: ${next.title}`}
			</span>
		</div>
	)}
</div>

<script>
	import { gsap } from 'gsap';
	import { navigate } from 'astro:transitions/client';

	function setup() {
		const root = document.getElementById('overscroll-root');
		if (!root) return;

		const currentId = root.getAttribute('data-current-id') ?? '';
		const fieldsUrl = root.getAttribute('data-fields-url') ?? '/fields';
		const nextUrl = root.getAttribute('data-next-url') ?? '';
		const backBtn = document.getElementById('back-to-fields-btn');
		const nextLink = document.getElementById('next-article-link');
		const topIndicator = document.getElementById('pull-top-indicator');
		const bottomIndicator = document.getElementById('pull-bottom-indicator');

		if (currentId) {
			sessionStorage.setItem('fields-target-marker', currentId);
		}

		let isNavigating = false;

		async function goBackToFields() {
			if (isNavigating) return;
			isNavigating = true;
			if (currentId) {
				sessionStorage.setItem('fields-target-marker', currentId);
			}
			const overlay = document.getElementById('field-transition-overlay');
			if (overlay) {
				await gsap.to(overlay, { opacity: 1, duration: 0.3, ease: 'power1.in' });
			}
			navigate(fieldsUrl);
		}

		async function goToNext() {
			if (isNavigating || !nextUrl) return;
			isNavigating = true;
			// Slide transition: animate main upward
			const main = document.querySelector('main');
			if (main) {
				await gsap.to(main, {
					y: -80,
					opacity: 0,
					duration: 0.35,
					ease: 'power2.in',
				});
			}
			navigate(nextUrl);
		}

		backBtn?.addEventListener('click', goBackToFields);
		nextLink?.addEventListener('click', (e) => {
			e.preventDefault();
			goToNext();
		});

		// Overscroll thresholds
		const THRESHOLD = 80;
		let pullTopDistance = 0;
		let pullBottomDistance = 0;
		let isTrackingTouch = false;
		let touchStartY = 0;

		function updateTopIndicator(dist: number) {
			if (!topIndicator) return;
			const progress = Math.min(dist / THRESHOLD, 1);
			topIndicator.style.opacity = progress.toString();
			topIndicator.style.transform = `translateY(${progress * 12}px)`;
		}

		function updateBottomIndicator(dist: number) {
			if (!bottomIndicator) return;
			const progress = Math.min(dist / THRESHOLD, 1);
			bottomIndicator.style.opacity = progress.toString();
			bottomIndicator.style.transform = `translateY(-${progress * 12}px)`;
		}

		function handleWheel(e: WheelEvent) {
			if (isNavigating) return;
			const scrollTop = window.scrollY || document.documentElement.scrollTop;
			const maxScroll = document.documentElement.scrollHeight - window.innerHeight;

			// Top overscroll
			if (scrollTop <= 1 && e.deltaY < 0) {
				pullTopDistance += Math.abs(e.deltaY) * 0.4;
				updateTopIndicator(pullTopDistance);
				if (pullTopDistance >= THRESHOLD) {
					goBackToFields();
				}
			} else if (pullTopDistance > 0 && e.deltaY > 0) {
				pullTopDistance = Math.max(0, pullTopDistance - e.deltaY);
				updateTopIndicator(pullTopDistance);
			}

			// Bottom overscroll (only if next article exists)
			if (nextUrl && scrollTop >= maxScroll - 2 && e.deltaY > 0) {
				pullBottomDistance += e.deltaY * 0.4;
				updateBottomIndicator(pullBottomDistance);
				if (pullBottomDistance >= THRESHOLD) {
					goToNext();
				}
			} else if (pullBottomDistance > 0 && e.deltaY < 0) {
				pullBottomDistance = Math.max(0, pullBottomDistance + e.deltaY);
				updateBottomIndicator(pullBottomDistance);
			}
		}

		function handleTouchStart(e: TouchEvent) {
			if (e.touches.length !== 1) return;
			touchStartY = e.touches[0].clientY;
			isTrackingTouch = true;
			pullTopDistance = 0;
			pullBottomDistance = 0;
		}

		function handleTouchMove(e: TouchEvent) {
			if (!isTrackingTouch || isNavigating) return;
			const touchY = e.touches[0].clientY;
			const deltaY = touchY - touchStartY;
			const scrollTop = window.scrollY || document.documentElement.scrollTop;
			const maxScroll = document.documentElement.scrollHeight - window.innerHeight;

			if (scrollTop <= 0 && deltaY > 0) {
				pullTopDistance = deltaY * 0.5;
				updateTopIndicator(pullTopDistance);
			} else if (nextUrl && scrollTop >= maxScroll - 1 && deltaY < 0) {
				pullBottomDistance = Math.abs(deltaY) * 0.5;
				updateBottomIndicator(pullBottomDistance);
			}
		}

		function handleTouchEnd() {
			if (!isTrackingTouch) return;
			isTrackingTouch = false;

			if (pullTopDistance >= THRESHOLD) {
				goBackToFields();
			} else {
				updateTopIndicator(0);
			}

			if (pullBottomDistance >= THRESHOLD && nextUrl) {
				goToNext();
			} else {
				updateBottomIndicator(0);
			}
			pullTopDistance = 0;
			pullBottomDistance = 0;
		}

		window.addEventListener('wheel', handleWheel, { passive: true });
		window.addEventListener('touchstart', handleTouchStart, { passive: true });
		window.addEventListener('touchmove', handleTouchMove, { passive: true });
		window.addEventListener('touchend', handleTouchEnd, { passive: true });

		// Fade out overlay on page entry
		const overlay = document.getElementById('field-transition-overlay');
		if (overlay) {
			gsap.to(overlay, { opacity: 0, duration: 0.35, ease: 'power1.out' });
		}
	}

	document.addEventListener('astro:page-load', setup);
</script>
