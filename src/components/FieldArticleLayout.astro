---
/**
 * GUSCIO COMUNE DELLE QUATTRO PAGINE DI DETTAGLIO DI FIELDS
 * ========================================================
 *
 * Impaginato editoriale "Marginalia scientifica" (validato in un canvas
 * /design): tre colonne su desktop — indice a sinistra, corpo al centro,
 * note a margine a destra — che collassano a colonna unica sotto 1180px.
 *
 * Le quattro PaginaXxxDettaglio.astro passano qui i pezzi category-specific
 * via props e slot (`tag`, `meta`, default = <Content />). L'indice si
 * costruisce dagli `headings` di `render(entry)` (Astro inietta gli id sugli
 * <h2>). Miniature, scroll-spy e spostamento delle note a margine li fa
 * src/scripts/impagina-articolo.ts, importato da FieldArticleBody.
 */
import '../styles/global.css';
import BaseHead from './BaseHead.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import FieldTransitionOverlay from './FieldTransitionOverlay.astro';
import FieldSimbolo from './FieldSimbolo.astro';
import FieldArticleNavigation from './FieldArticleNavigation.astro';
import FieldArticleBody from './FieldArticleBody.astro';
import TastoCondividi from './TastoCondividi.astro';
import type { FieldCategory, FieldMarker } from '../data/fields';
import type { MiniaturaFigura } from '../lib/miniature-figure';
import { type Lingua, t } from '../i18n/testi';

interface Props {
  categoria: FieldCategory;
  lingua: Lingua;
  titolo: string;
  sommario: string;
  /** Occhiello sopra il titolo, già composto dalla pagina (es. "Research · 2026"). */
  kicker: string;
  tradotto?: boolean;
  currentId: string;
  next?: FieldMarker;
  prev?: FieldMarker;
  headings: { depth: number; slug: string; text: string }[];
  /** Provini delle figure per la rail, generati a build time (vedi lib/miniature-figure). */
  figure?: MiniaturaFigura[];
}

const {
  categoria,
  lingua,
  titolo,
  sommario,
  kicker,
  tradotto,
  currentId,
  next,
  prev,
  headings,
  figure = [],
} = Astro.props;

const etichettaFig = (f: Extract<MiniaturaFigura, { didascalia: string }>) =>
  f.didascalia ? `Fig. ${f.n} — ${f.didascalia}` : `Fig. ${f.n}`;

// La rail laterale raccoglie in un solo gruppo i provini delle figure e i
// segnaposto delle tabelle (rettangolo con la sola etichetta "Tab N"): il
// titolo si adatta a cosa c'è davvero.
const haTabella = figure.some((f) => f.tipo === 'tabella');
const haFigura = figure.some((f) => f.tipo !== 'tabella');
const titoloRailFigure =
  haTabella && haFigura
    ? t('fields.figureTabelle', lingua)
    : haTabella
      ? t('fields.tabelle', lingua)
      : t('fields.figure', lingua);
const etichettaTab = (n: string) => `${t('fields.tabella', lingua)} ${n}`;

// `footnote-label` è l'<h2> "Footnotes" che remark-gfm aggiunge in coda:
// non è una sezione dell'articolo, fuori dall'indice.
const sezioni = headings.filter((h) => h.depth === 2 && h.slug !== 'footnote-label');
---

<html lang={lingua}>
  <head>
    <BaseHead title={`${titolo} — Graziano Enzo Marchesani`} description={sommario} />
  </head>
  <body class="bg-paper text-ink font-sans">
    <FieldTransitionOverlay />
    <FieldSimbolo categoria={categoria} />
    <Nav lingua={lingua} />

    <main class="field-shell">
      <header class="field-head">
        <p class="field-kicker">{kicker}</p>
        <h1 class="font-display mt-2 text-4xl">{titolo}</h1>
        <p class="mt-4 opacity-80">{sommario}</p>

        {tradotto === false && (
          <p class="mt-3 text-xs italic opacity-60">{t('fields.nonTradotto', lingua)}</p>
        )}

        <slot name="tag" />
      </header>

      {sezioni.length > 0 && (
        <nav class="field-rail" aria-label={t('fields.indice', lingua)}>
          <p class="field-rail-tit">{t('fields.indice', lingua)}</p>
          <ol class="field-rail-list">
            {sezioni.map((s) => (
              <li>
                <a data-h={s.slug} href={`#${s.slug}`}>{s.text}</a>
              </li>
            ))}
          </ol>
          {figure.length > 0 && (
            <div class="field-rail-figure-group">
              <p class="field-rail-tit">{titoloRailFigure}</p>
              <div class="field-rail-figure">
                {figure.map((f) =>
                  f.tipo === 'tabella' ? (
                    <a
                      class="field-rail-fig field-rail-fig--tab"
                      data-tab={f.n}
                      href={`#tabella-${f.n}`}
                      aria-label={etichettaTab(f.n)}
                      title={etichettaTab(f.n)}
                    >
                      <span class="sw sw--tab">Tab {f.n}</span>
                    </a>
                  ) : (
                    <a
                      class="field-rail-fig"
                      data-fig={f.n}
                      href="#"
                      aria-label={etichettaFig(f)}
                      title={etichettaFig(f)}
                    >
                      {f.tipo === 'immagine' ? (
                        <span class="sw">
                          <img
                            src={f.src}
                            alt=""
                            width={f.width}
                            height={f.height}
                            loading="eager"
                            decoding="async"
                          />
                        </span>
                      ) : (
                        <span class={`sw ph ph--${f.tipo === 'video' ? 'video' : 'chart'}`}></span>
                      )}
                    </a>
                  ),
                )}
              </div>
            </div>
          )}
        </nav>
      )}

      {sezioni.length > 0 && (
        <details class="field-toc">
          <summary>{t('fields.indice', lingua)}</summary>
          <ol>
            {sezioni.map((s) => (
              <li><a href={`#${s.slug}`}>{s.text}</a></li>
            ))}
          </ol>
        </details>
      )}

      <div class="field-body">
        <FieldArticleBody>
          <slot />
        </FieldArticleBody>

        <slot name="meta" />

        <div class="mt-12 flex justify-end">
          <TastoCondividi titolo={titolo} sommario={sommario} lingua={lingua} />
        </div>

        <FieldArticleNavigation currentId={currentId} next={next} prev={prev} lingua={lingua} />
      </div>

      <aside class="field-note" aria-label={t('fields.note', lingua)} hidden></aside>
    </main>

    <Footer lingua={lingua} />
  </body>
</html>

<style>
  .field-shell {
    --field-rail-w: 176px;
    --field-note-w: 232px;
    --field-gap: 44px;
    position: relative;
    z-index: 10;
    max-width: 40rem;
    margin: 0 auto;
    padding: 8rem 1.5rem 6rem;
  }

  @media (min-width: 640px) {
    .field-shell {
      padding-left: 2.5rem;
      padding-right: 2.5rem;
    }
  }

  .field-kicker {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.6;
  }

  /* --- Indice: <details> nel flusso sotto 1180px --------------------------- */
  .field-toc {
    margin-top: 2rem;
    font-size: 0.8125rem;
  }
  .field-toc > summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .field-toc ol {
    margin-top: 0.75rem;
    padding-left: 0;
    list-style: none;
  }
  .field-toc li {
    padding: 0.35rem 0;
  }
  .field-toc a {
    text-decoration: none;
  }
  .field-toc a:hover {
    opacity: 0.6;
  }

  .field-rail,
  .field-note {
    display: none;
  }

  /* --- Tre colonne su desktop ------------------------------------------------ */
  @media (min-width: 1180px) {
    .field-shell {
      display: grid;
      grid-template-columns: var(--field-rail-w) minmax(0, 40rem) var(--field-note-w);
      column-gap: var(--field-gap);
      align-items: start;
      max-width: calc(
        var(--field-rail-w) + 40rem + var(--field-note-w) + 2 * var(--field-gap)
      );
      padding-top: 9rem;
    }

    /* Articolo senza sezioni <h2>: niente indice né note, torna a colonna unica
       centrata invece di lasciare le tracce laterali vuote. */
    .field-shell:not(:has(.field-rail)) {
      display: block;
      max-width: 40rem;
    }

    .field-head {
      grid-column: 2 / 3;
    }

    .field-toc {
      display: none;
    }

    .field-rail {
      display: block;
      grid-column: 1 / 2;
      grid-row: 2;
      position: sticky;
      top: 6rem;
      z-index: 2;
      padding-right: 0.75rem;
      font-size: 0.75rem;
      line-height: 1.5;
    }

    .field-body {
      grid-column: 2 / 3;
      grid-row: 2;
      min-width: 0;
    }

    .field-note {
      display: block;
      grid-column: 3 / 4;
      grid-row: 2;
      position: sticky;
      top: 6rem;
      z-index: 2;
      padding-left: 0.75rem;
      font-size: 0.75rem;
      line-height: 1.5;
    }

    .field-rail-tit {
      font-family: var(--font-display);
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      opacity: 0.55;
      margin-bottom: 0.6rem;
    }

    .field-rail-list {
      margin: 0 0 1.5rem;
      padding: 0;
      list-style: none;
    }
    .field-rail-list li {
      padding: 0.35rem 0;
      border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    }
    .field-rail-list a {
      text-decoration: none;
      opacity: 0.7;
      transition: opacity 0.15s;
    }
    .field-rail-list a:hover,
    .field-rail-list a.is-on {
      opacity: 1;
    }
    .field-rail-list a.is-on {
      font-weight: 600;
    }

    .field-rail-figure-group {
      margin-top: 1.5rem;
    }
    .field-rail-figure {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.4rem;
    }
    /* :global perché queste voci le crea impagina-articolo.ts a runtime e non
       portano l'attributo di scope del componente. */
    .field-rail-figure :global(.field-rail-fig) {
      display: block;
      min-width: 0;
      text-decoration: none;
      opacity: 0.85;
      transition: opacity 0.15s;
    }
    .field-rail-figure :global(.field-rail-fig:hover) {
      opacity: 1;
    }
    .field-rail-figure :global(.field-rail-fig .sw) {
      display: flex;
      align-items: center;
      justify-content: center;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: color-mix(in srgb, var(--color-ink) 6%, transparent);
      border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    }
    .field-rail-figure :global(.field-rail-fig .sw img) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .field-rail-figure :global(.field-rail-fig .sw svg) {
      display: block;
      width: 100%;
      height: 100%;
    }
    /* Il grafico è solo la linea su carta: niente tinta di fondo. */
    .field-rail-figure :global(.field-rail-fig .sw:has(svg)) {
      background: var(--color-paper);
    }

    /* Tabella: nessun provino leggibile a questa scala, solo un rettangolo
       dedicato con l'etichetta "Tab N". Bordo tratteggiato per distinguerlo
       dai provini veri. */
    .field-rail-figure :global(.field-rail-fig--tab .sw--tab) {
      border-style: dashed;
      background: color-mix(in srgb, var(--color-ink) 4%, transparent);
      font-family: var(--font-display);
      font-size: 0.8125rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: color-mix(in srgb, var(--color-ink) 62%, transparent);
    }
    .field-rail-figure :global(.field-rail-fig--tab:hover .sw--tab) {
      color: var(--color-ink);
    }
    /* Segnaposto standard quando non c'è un'immagine (video, o grafico non ancora montato). */
    .field-rail-figure :global(.field-rail-fig .sw.ph)::before {
      opacity: 0.4;
      font-size: 1rem;
    }
    .field-rail-figure :global(.field-rail-fig .sw.ph--video)::before {
      content: '▶';
    }
    .field-rail-figure :global(.field-rail-fig .sw.ph--chart)::before {
      content: '▦';
    }

    /* Note a margine: footnotes Markdown spostate qui dallo script */
    .field-note :global(.footnotes) {
      margin: 0;
    }
    .field-note :global(.footnotes ol) {
      margin: 0;
      padding: 0;
      list-style: none;
      counter-reset: nota;
    }
    .field-note :global(.footnotes li) {
      counter-increment: nota;
      padding: 0.5rem 0 0.75rem;
      border-top: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
      cursor: pointer;
    }
    .field-note :global(.footnotes li a) {
      cursor: auto;
    }
    .field-note :global(.footnotes li)::before {
      content: counter(nota);
      font-family: var(--font-display);
      margin-right: 0.4rem;
    }
    .field-note :global(.footnotes li p) {
      display: inline;
      margin: 0;
    }

    /* Clic sul richiamo nel corpo: rettangolo grigiastro sotto la nota
       (stessa animazione delle pubblicazioni cercate). */
    .field-note :global(.footnotes li.nota--evidenziata) {
      animation: evidenziaNota 2.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes evidenziaNota {
      0%,
      65% {
        background-color: color-mix(in srgb, var(--color-ink) 12%, transparent);
        box-shadow: 0 0 0 8px color-mix(in srgb, var(--color-ink) 12%, transparent);
        border-radius: 0.35rem;
      }
      100% {
        background-color: transparent;
        box-shadow: 0 0 0 0 transparent;
        border-radius: 0.35rem;
      }
    }
    /* Verso opposto: clic sulla nota → evidenzia nel testo la frase che
       contiene il richiamo (marcatore grigiastro, come la ricerca). */
    :global(.field-article .fnref--evidenziato) {
      animation: evidenziaFnref 2.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      border-radius: 0.15rem;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }
    @keyframes evidenziaFnref {
      0%,
      65% {
        background-color: color-mix(in srgb, var(--color-ink) 14%, transparent);
      }
      100% {
        background-color: transparent;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .field-note :global(.footnotes li.nota--evidenziata),
      :global(.field-article .fnref--evidenziato) {
        animation: none;
        background-color: color-mix(in srgb, var(--color-ink) 14%, transparent);
      }
    }
  }
</style>
