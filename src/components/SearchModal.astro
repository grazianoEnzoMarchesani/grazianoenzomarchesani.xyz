---
import { type Lingua, t } from '../i18n/testi';

interface Props {
  lingua?: Lingua;
}

const { lingua = 'en' } = Astro.props;
---

<div
  id="search-dialog"
  class="fixed inset-0 z-50 flex items-start justify-center p-4 sm:p-6 md:p-20 opacity-0 pointer-events-none transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-modal-title"
>
  <!-- Backdrop -->
  <div id="search-backdrop" class="fixed inset-0 bg-ink/40 backdrop-blur-md transition-opacity"></div>

  <!-- Modal Container -->
  <div
    class="relative z-10 flex w-full max-w-2xl flex-col rounded-2xl bg-paper shadow-2xl border border-ink/10 overflow-hidden max-h-[80vh] transition-transform duration-200 scale-95"
    id="search-panel"
  >
    <!-- Header / Input -->
    <div class="flex items-center gap-3 border-b border-ink/10 px-4 py-3 sm:px-5">
      <svg class="h-5 w-5 text-ink/40 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder={t('search.placeholder', lingua)}
        class="w-full bg-transparent text-sm sm:text-base text-ink placeholder:text-ink/40 focus:outline-none"
        autocomplete="off"
        spellcheck="false"
      />
      <div class="flex items-center gap-1.5 shrink-0">
        <kbd class="hidden sm:inline-flex items-center rounded border border-ink/15 bg-ink/5 px-1.5 py-0.5 text-[10px] font-mono text-ink/60 uppercase">ESC</kbd>
        <button
          id="search-close-btn"
          class="rounded p-1 text-ink/50 hover:bg-ink/5 hover:text-ink transition-colors"
          aria-label={t('search.chiudi', lingua)}
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Status Bar / Engine Info -->
    <div id="search-status" class="flex items-center justify-between border-b border-ink/5 bg-ink/[0.02] px-4 py-1.5 text-[11px] text-ink/60">
      <div class="flex items-center gap-2">
        <span id="status-indicator" class="h-2 w-2 rounded-full bg-ink/20"></span>
        <span id="status-text">{t('search.caricamentoModello', lingua)}</span>
      </div>
      <div class="flex items-center gap-2 font-mono text-[10px] opacity-60">
        <span>↑↓ navigate</span>
        <span>↵ select</span>
      </div>
    </div>

    <!-- Results List -->
    <div id="search-results" class="flex-1 overflow-y-auto p-2 divide-y divide-ink/5">
      <div id="search-empty-state" class="py-12 text-center text-xs text-ink/40">
        {t('search.placeholder', lingua)}
      </div>
    </div>
  </div>
</div>

<script>
  import { searchEngine, type DocumentoRicerca } from '../scripts/search-client';

  let isOpen = false;
  let activeIndex = -1;
  let currentResults: DocumentoRicerca[] = [];
  let debounceTimeout: ReturnType<typeof setTimeout>;

  function getElements() {
    return {
      dialog: document.getElementById('search-dialog'),
      panel: document.getElementById('search-panel'),
      backdrop: document.getElementById('search-backdrop'),
      input: document.getElementById('search-input') as HTMLInputElement | null,
      closeBtn: document.getElementById('search-close-btn'),
      resultsContainer: document.getElementById('search-results'),
      statusText: document.getElementById('status-text'),
      statusIndicator: document.getElementById('status-indicator'),
      lingua: document.documentElement.lang || 'en',
    };
  }

  function openSearch() {
    const { dialog, panel, input } = getElements();
    if (!dialog || !panel) return;
    isOpen = true;
    dialog.classList.remove('opacity-0', 'pointer-events-none');
    panel.classList.remove('scale-95');
    panel.classList.add('scale-100');
    document.body.style.overflow = 'hidden';

    // Sincronizza subito lo stato visivo (se già pronto non mostra "inizializzazione")
    updateStatusUI(searchEngine.getStato());

    // Inizializza indice e modello ONNX on-demand
    searchEngine.inizializzaIndice();
    searchEngine.inizializzaWorker();

    setTimeout(() => input?.focus(), 50);
  }

  function closeSearch() {
    const { dialog, panel, input } = getElements();
    isOpen = false;
    if (dialog && panel) {
      dialog.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.add('scale-95');
      panel.classList.remove('scale-100');
    }
    document.body.style.overflow = '';
    if (input) input.value = '';
    renderResults([]);
  }

  function updateStatusUI(stato: { modelloPronto: boolean; caricamento: boolean; percentuale: number }) {
    const { statusText, statusIndicator, lingua } = getElements();
    if (!statusText || !statusIndicator) return;
    if (stato.modelloPronto) {
      statusIndicator.className = 'h-2 w-2 rounded-full bg-ink';
      statusText.textContent = lingua === 'it' ? 'Motore semantico vettoriale pronto' : 'Vector semantic engine active';
    } else if (stato.caricamento) {
      statusIndicator.className = 'h-2 w-2 rounded-full bg-ink/30 animate-pulse';
      const pct = stato.percentuale > 0 ? ` (${stato.percentuale}%)` : '';
      statusText.textContent = (lingua === 'it' ? 'Inizializzazione motore neurale' : 'Loading neural model') + pct;
    }
  }

  // Sottoscrivi aggiornamenti stato motore neurale
  searchEngine.onStatoChange((stato) => {
    updateStatusUI(stato);
  });

  function renderResults(results: DocumentoRicerca[]) {
    const { resultsContainer, input, lingua } = getElements();
    if (!resultsContainer) return;
    currentResults = results;
    activeIndex = -1;

    if (!input?.value.trim()) {
      resultsContainer.innerHTML = `
        <div class="py-12 text-center text-xs text-ink/40">
          ${lingua === 'it' ? 'Inizia a digitare per cercare ovunque nel sito...' : 'Start typing to search across research, projects, tools...'}
        </div>
      `;
      return;
    }

    if (results.length === 0) {
      resultsContainer.innerHTML = `
        <div class="py-12 text-center text-xs text-ink/50">
          ${lingua === 'it' ? 'Nessun risultato trovato per la ricerca.' : 'No matching results found.'}
        </div>
      `;
      return;
    }

    resultsContainer.innerHTML = results
      .map(
        (r, idx) => `
      <a
        href="${r.url}"
        data-index="${idx}"
        class="search-item group flex flex-col gap-1 rounded-xl p-3 text-left transition-colors hover:bg-ink/5 focus:bg-ink/5 focus:outline-none"
      >
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2 min-w-0">
            <span class="rounded bg-ink/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-ink/70 shrink-0">
              ${r.categoria}
            </span>
            <span class="font-medium text-ink text-sm sm:text-base truncate group-hover:text-black">
              ${r.titolo}
            </span>
          </div>
          ${
            lingua === 'it' && r.lingua === 'en'
              ? `<span class="shrink-0 rounded bg-ink/5 px-1.5 py-0.5 text-[10px] uppercase tracking-wider text-ink/50 font-mono">EN</span>`
              : ''
          }
        </div>
        ${r.sommario ? `<p class="line-clamp-2 text-xs text-ink/60 leading-relaxed">${r.sommario}</p>` : ''}
      </a>
    `
      )
      .join('');
  }

  function updateActiveItem(index: number) {
    const { resultsContainer } = getElements();
    const items = resultsContainer?.querySelectorAll<HTMLElement>('.search-item');
    if (!items || items.length === 0) return;

    items.forEach((it) => it.classList.remove('bg-ink/10'));
    if (index >= 0 && index < items.length) {
      activeIndex = index;
      items[index].classList.add('bg-ink/10');
      items[index].scrollIntoView({ block: 'nearest' });
    }
  }

  function bindInputListeners() {
    const { input, backdrop, closeBtn } = getElements();

    if (input && !input.dataset.searchBound) {
      input.dataset.searchBound = 'true';

      input.addEventListener('input', () => {
        clearTimeout(debounceTimeout);
        debounceTimeout = setTimeout(async () => {
          const { lingua } = getElements();
          const q = input.value;
          const res = await searchEngine.cerca(q, lingua);
          renderResults(res);
        }, 120);
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          updateActiveItem(Math.min(activeIndex + 1, currentResults.length - 1));
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          updateActiveItem(Math.max(activeIndex - 1, 0));
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (activeIndex >= 0 && currentResults[activeIndex]) {
            window.location.href = currentResults[activeIndex].url;
          } else if (currentResults.length > 0) {
            window.location.href = currentResults[0].url;
          }
        }
      });
    }

    if (backdrop && !backdrop.dataset.searchBound) {
      backdrop.dataset.searchBound = 'true';
      backdrop.addEventListener('click', closeSearch);
    }

    if (closeBtn && !closeBtn.dataset.searchBound) {
      closeBtn.dataset.searchBound = 'true';
      closeBtn.addEventListener('click', closeSearch);
    }

    updateStatusUI(searchEngine.getStato());
  }

  // Global shortcut (Cmd+K / Ctrl+K / Escape) — una sola registrazione globale
  if (!(window as any).__searchShortcutsRegistered) {
    (window as any).__searchShortcutsRegistered = true;

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (isOpen) closeSearch();
        else openSearch();
      } else if (e.key === 'Escape' && isOpen) {
        closeSearch();
      }
    });

    document.addEventListener('open-search', openSearch);
  }

  // Binding iniziale e ad ogni cambio pagina/lingua con Astro
  bindInputListeners();
  document.addEventListener('astro:page-load', () => {
    bindInputListeners();
  });
</script>
