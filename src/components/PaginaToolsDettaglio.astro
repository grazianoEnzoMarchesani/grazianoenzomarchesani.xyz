---
import BaseHead from './BaseHead.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getAdjacentFieldMarker } from '../data/fields-content';
import '../styles/global.css';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import FieldTransitionOverlay from './FieldTransitionOverlay.astro';
import FieldArticleNavigation from './FieldArticleNavigation.astro';
import FieldArticleBody from './FieldArticleBody.astro';
import { type Lingua, linguaDefault, t } from '../i18n/testi';

interface Props {
  entry: CollectionEntry<'tools'> & { chiave: string; tradotto?: boolean };
  lingua?: Lingua;
}

const { entry, lingua = (Astro.currentLocale as Lingua) || linguaDefault } = Astro.props;
const currentId = `tools/${entry.chiave}`;
const { next, prev } = await getAdjacentFieldMarker(currentId, lingua);
const { Content } = await render(entry);

const { nome, sommario, data, linguaggio, ambiente, repo, doi, sito, licenza } = entry.data;
---

<html lang={lingua}>
  <head>
    <BaseHead title={`${nome} — Graziano Enzo Marchesani`} description={sommario} />
  </head>
  <body class="bg-paper text-ink font-sans">
    <FieldTransitionOverlay />
    <Nav lingua={lingua} />

    <main class="mx-auto max-w-2xl px-6 pt-32 pb-24 sm:px-10">
      <p class="text-xs uppercase tracking-widest opacity-60">
        {t('fields.tools', lingua)} · {data.getFullYear()}
      </p>
      <h1 class="font-display mt-2 text-4xl">{nome}</h1>
      <p class="mt-4 opacity-80">{sommario}</p>

      {entry.tradotto === false && (
        <p class="mt-3 text-xs italic opacity-60">
          {t('fields.nonTradotto', lingua)}
        </p>
      )}

      <ul class="mt-4 flex flex-wrap gap-2">
        {linguaggio && (
          <li class="rounded-full border border-ink/20 px-3 py-1 text-xs uppercase tracking-widest opacity-70">
            {linguaggio}
          </li>
        )}
        {ambiente.map((a) => (
          <li class="rounded-full border border-ink/20 px-3 py-1 text-xs uppercase tracking-widest opacity-70">
            {a}
          </li>
        ))}
      </ul>

      <FieldArticleBody>
        <Content />
      </FieldArticleBody>

      <ul class="mt-10 space-y-2 text-sm">
        <li>
          <a href={repo} class="underline hover:opacity-60" target="_blank" rel="noopener noreferrer">
            {t('fields.repo', lingua)}
          </a>
        </li>
        {sito && (
          <li>
            <a href={sito} class="underline hover:opacity-60" target="_blank" rel="noopener noreferrer">
              {t('fields.sito', lingua)}
            </a>
          </li>
        )}
        {doi && (
          <li>
            <a href={doi} class="underline hover:opacity-60" target="_blank" rel="noopener noreferrer">
              {t('fields.doi', lingua)}
            </a>
          </li>
        )}
        {licenza && <li class="opacity-70">{t('fields.licenza', lingua)}: {licenza}</li>}
      </ul>

      <FieldArticleNavigation currentId={currentId} next={next} prev={prev} lingua={lingua} />
    </main>

    <Footer />
  </body>
</html>
