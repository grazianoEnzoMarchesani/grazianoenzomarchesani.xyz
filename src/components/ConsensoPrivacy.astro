---
/**
 * Banner e pannello delle preferenze privacy — stesso componente, due ruoli.
 *
 * Compare da sé a chi non ha ancora scelto; si riapre su richiesta dal link
 * «Privacy» nel footer, e in quel caso mostra anche lo stato corrente.
 *
 * Requisiti vincolanti (provv. Garante 231/2021), da non ridiscutere in fase di
 * restyling: «Accetta» e «Rifiuta» hanno le stesse classi, quindi lo stesso peso
 * visivo e lo stesso costo di click; la ✕ chiude senza acconsentire; lo scroll
 * non vale come consenso; il contenuto del sito resta accessibile in ogni caso.
 */
import { type Lingua, linguaDefault, t } from '../i18n/testi';

const lingua: Lingua =
  Astro.props.lingua || (Astro.currentLocale as Lingua) || (Astro.url.pathname.startsWith('/it') ? 'it' : linguaDefault);

const urlInformativa = lingua === 'it' ? '/it/privacy/' : '/privacy/';

const azione = 'flex-1 cursor-pointer rounded-full border border-ink/25 px-4 py-2 text-[11px] font-mono uppercase tracking-wider text-ink transition-colors hover:bg-ink hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink';
---

<div
  id="privacy-banner"
  class="pointer-events-none fixed inset-x-4 bottom-16 z-40 hidden sm:inset-x-auto sm:left-10 sm:bottom-20 sm:w-full sm:max-w-md"
  role="dialog"
  aria-labelledby="privacy-titolo"
>
  <div class="pointer-events-auto rounded-2xl border border-ink/10 bg-paper/95 p-4 shadow-2xl backdrop-blur-md sm:p-5">
    <div class="flex items-start justify-between gap-3">
      <h2 id="privacy-titolo" class="text-[11px] font-mono uppercase tracking-widest text-ink/70">
        {t('privacy.titolo', lingua)}
      </h2>
      <button
        id="privacy-chiudi"
        type="button"
        class="-mt-1 cursor-pointer rounded p-1 text-ink/50 transition-colors hover:bg-ink/5 hover:text-ink"
        aria-label={t('privacy.chiudi', lingua)}
        title={t('privacy.chiudi', lingua)}
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    {/* Visibile solo quando il pannello è riaperto dal footer: a chi non ha ancora
        scelto non serve, e dichiarare uno «stato attuale» prima della scelta
        suggerirebbe un default che non esiste. */}
    <p id="privacy-stato" class="mt-2 hidden text-[11px] font-mono uppercase tracking-wider text-ink/60">
      <span>{t('privacy.statoCorrente', lingua)}:</span>
      <span id="privacy-stato-valore" class="text-ink"></span>
    </p>

    <p class="mt-3 text-sm font-medium leading-snug text-ink">{t('privacy.intro', lingua)}</p>
    <p class="mt-2 text-xs leading-relaxed text-ink/70">{t('privacy.dettaglio', lingua)}</p>
    <p class="mt-2 text-xs leading-relaxed text-ink/70">{t('privacy.rifiuto', lingua)}</p>

    <div class="mt-4 flex gap-2">
      <button id="privacy-accetta" type="button" class={azione}>{t('privacy.accetta', lingua)}</button>
      <button id="privacy-rifiuta" type="button" class={azione}>{t('privacy.rifiuta', lingua)}</button>
    </div>

    <a
      href={urlInformativa}
      class="mt-3 inline-block text-[11px] font-mono uppercase tracking-wider text-ink/60 underline underline-offset-2 transition-colors hover:text-ink"
    >
      {t('privacy.informativa', lingua)}
    </a>
  </div>
</div>

<script>
  import { registra, serveChiedere, sceltaRegistrata, dimenticaModello } from '../scripts/consenso';

  const banner = () => document.getElementById('privacy-banner');

  function apri(mostraStato: boolean) {
    const elemento = banner();
    if (!elemento) return;
    const riga = document.getElementById('privacy-stato');
    const valore = document.getElementById('privacy-stato-valore');
    if (riga && valore) {
      riga.classList.toggle('hidden', !mostraStato);
      if (mostraStato) {
        const it = document.documentElement.lang === 'it';
        valore.textContent =
          sceltaRegistrata() === 'accettato'
            ? it ? 'funzioni facoltative attive' : 'optional features enabled'
            : it ? 'funzioni facoltative disattivate' : 'optional features disabled';
      }
    }
    elemento.classList.remove('hidden');
  }

  const chiudi = () => banner()?.classList.add('hidden');

  /**
   * Chi non ha ancora scelto vede il banner; chi ha già scelto no, per sei mesi.
   * Chiudere con la ✕ non registra nulla: il banner tornerà, ma intanto lo stato
   * resta quello di rifiuto, che è già lo stato di partenza.
   */
  function valutaVisibilita() {
    if (serveChiedere()) apri(false);
    else chiudi();
  }

  if (!(window as any).__privacyRegistrato) {
    (window as any).__privacyRegistrato = true;

    document.addEventListener('click', async (evento) => {
      const bersaglio = evento.target as HTMLElement | null;
      if (!bersaglio) return;

      if (bersaglio.closest('#privacy-accetta')) {
        registra('accettato');
        chiudi();
      } else if (bersaglio.closest('#privacy-rifiuta')) {
        registra('rifiutato');
        chiudi();
        // La revoca deve avere effetto reale: i ~33 MB non possono restare sul
        // dispositivo di chi ha appena negato il consenso ad archiviarli.
        await dimenticaModello();
      } else if (bersaglio.closest('#privacy-chiudi')) {
        chiudi();
      }
    });

    document.addEventListener('privacy:apri', () => apri(true));
    document.addEventListener('astro:page-load', valutaVisibilita);
  }

  valutaVisibilita();
</script>
