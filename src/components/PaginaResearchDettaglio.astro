---
import { render, type CollectionEntry } from 'astro:content';
import { getAdjacentFieldMarker } from '../data/fields-content';
import FieldArticleLayout from './FieldArticleLayout.astro';
import ElencoTag from './ElencoTag.astro';
import { miniatureFigure } from '../lib/miniature-figure';
import { type Lingua, linguaDefault, t } from '../i18n/testi';

interface Props {
  entry: CollectionEntry<'research'> & { chiave: string; tradotto?: boolean };
  lingua?: Lingua;
}

const { entry, lingua = (Astro.currentLocale as Lingua) || linguaDefault } = Astro.props;
const currentId = `research/${entry.chiave}`;
const { next, prev } = await getAdjacentFieldMarker(currentId, lingua);
const { Content, headings } = await render(entry);
const figure = await miniatureFigure(entry);

const { titolo, data, sommario, tag, fonte, fonteUrl } = entry.data;
const kicker = `${t('fields.research', lingua)} · ${data.getFullYear()}`;
---

<FieldArticleLayout
  categoria="research"
  lingua={lingua}
  titolo={titolo}
  sommario={sommario}
  kicker={kicker}
  tradotto={entry.tradotto}
  currentId={currentId}
  next={next}
  prev={prev}
  headings={headings}
  figure={figure}
>
  <ElencoTag slot="tag" id={currentId} lingua={lingua} grezzi={tag} />

  <Content />

  {fonte && (
    <p slot="meta" class="mt-10 text-sm opacity-70">
      {t('fields.fonte', lingua)}:{' '}
      {fonteUrl ? (
        <a href={fonteUrl} class="underline hover:opacity-60" target="_blank" rel="noopener noreferrer">
          {fonte}
        </a>
      ) : (
        fonte
      )}
    </p>
  )}
</FieldArticleLayout>
