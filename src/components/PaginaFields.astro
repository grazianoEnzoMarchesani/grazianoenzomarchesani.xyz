---
import BaseHead from './BaseHead.astro';
import '../styles/global.css';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import FieldTransitionOverlay from './FieldTransitionOverlay.astro';
import { FIELD_CATEGORY_ORDER } from '../data/fields';
import { getFieldsTimeline } from '../data/fields-content';
import { getIndiceTag } from '../lib/tag';
import { type Lingua, linguaDefault, t } from '../i18n/testi';

interface Props {
	lingua?: Lingua;
}

const { lingua = (Astro.currentLocale as Lingua) || linguaDefault } = Astro.props;
const timeline = await getFieldsTimeline(lingua);
const { tag } = await getIndiceTag(lingua);
/** slug -> etichetta: i satelliti mostrano il nome, l'URL porta lo slug. */
const dizionarioTag = Object.fromEntries(tag.map((v) => [v.slug, v.etichetta]));
const titolo = t('fields.titolo', lingua);

const categoryLabels: Record<string, string> = {
	research: t('fields.research', lingua),
	tools: t('fields.tools', lingua),
	teaching: t('fields.teaching', lingua),
	projects: t('fields.projects', lingua),
};
---

<html lang={lingua}>
	<head>
		<BaseHead title={`${titolo} — Graziano Enzo Marchesani`} />
	</head>
	<body class="bg-paper text-ink font-sans">
		<FieldTransitionOverlay />
		<Nav lingua={lingua} />

		<main data-lingua={lingua}>
			<section id="fields-pin" class="relative h-dvh w-full overflow-hidden" aria-hidden="true">
				<canvas id="fields-canvas" class="absolute inset-0 h-full w-full"></canvas>
				<div
					id="fields-anno-watermark"
					class="pointer-events-none absolute left-2 top-20 z-0 block h-[1em] w-[3.5em] select-none overflow-hidden font-display leading-none tracking-tight text-ink/[0.06] text-[clamp(6rem,18vw,16rem)] opacity-0 sm:left-6"
					aria-hidden="true"
				></div>
				<div id="fields-labels" class="pointer-events-none absolute inset-0 h-full w-full overflow-hidden" aria-hidden="true"></div>
			</section>

			<ul
				id="fields-list"
				class="sr-only mx-auto max-w-2xl space-y-12 px-6 pt-28 pb-24 sm:px-10"
				aria-label="Elenco cronologico dei contenuti Fields"
			>
				{timeline.map((yearData) => (
					<li>
						<span class="font-display text-3xl">{yearData.year}</span>
						<ul class="mt-4 space-y-6">
							{FIELD_CATEGORY_ORDER.map((category) => {
								const items = yearData.markers.filter((m) => m.category === category);
								if (items.length === 0) return null;
								return (
									<li>
										<span class="text-xs uppercase tracking-widest opacity-60">{categoryLabels[category]}</span>
										<ul class="mt-2 space-y-1">
											{items.map((m) => <li class="text-sm">{m.title}</li>)}
										</ul>
									</li>
								);
							})}
						</ul>
					</li>
				))}
			</ul>

			<div id="fields-tag-layer" class="pointer-events-none fixed inset-0 z-20" aria-hidden="true"></div>

			<div
				id="fields-tag-bar"
				class="pointer-events-none fixed inset-x-0 top-24 z-30 mx-auto flex max-w-3xl flex-wrap justify-center gap-2 px-6"
				hidden
			></div>

			<button
				id="fields-tag-toggle"
				type="button"
				class="fields-tag-toggle pillola-tag fixed bottom-14 left-1/2 z-30 hidden -translate-x-1/2 items-center gap-2 rounded-full px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-ink/80 sm:bottom-16"
				aria-pressed="false"
				aria-label={t('tag.filtro', lingua)}
			>
				<span class="fields-tag-pallino" aria-hidden="true"></span>
				<span aria-hidden="true">{t('tag.occhiello', lingua)}</span>
				<span id="fields-tag-conteggio" class="font-mono text-[10px] tracking-widest opacity-60" aria-hidden="true"></span>
			</button>

			<script type="application/json" id="fields-data" is:inline set:html={JSON.stringify(timeline)} />
			<script type="application/json" id="fields-tag-dizionario" is:inline set:html={JSON.stringify(dizionarioTag)} />
			<span id="fields-tag-testi" hidden data-rimuovi={t('tag.rimuovi', lingua)}></span>
		</main>

		<Footer lingua={lingua} />
	</body>
</html>

<script>
	import { gsap } from 'gsap';
	import { navigate } from 'astro:transitions/client';
	import { initFieldsSpiral, OPEN_ZOOM_DURATION_MS } from '../scripts/fields-spiral';
	import {
		creaFiltroTag,
		filtraTimeline,
		leggiTagAttivi,
		urlConTag,
		type DizionarioTag,
	} from '../scripts/fields-tag';
	import type { FieldYear } from '../data/fields';

	let spiralHandle: { destroy: () => void } | undefined;
	let filtro: ReturnType<typeof creaFiltroTag> | undefined;

	function cleanup() {
		spiralHandle?.destroy();
		spiralHandle = undefined;
		filtro?.destroy();
		filtro = undefined;
	}

	function setup() {
		cleanup();

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const list = document.getElementById('fields-list');
		const pinSection = document.getElementById('fields-pin');
		const main = document.querySelector('main[data-lingua]');
		const lingua = main?.getAttribute('data-lingua') || 'en';

		if (prefersReducedMotion) {
			pinSection?.remove();
			list?.classList.remove('sr-only');
			list?.removeAttribute('aria-hidden');
			return;
		}

		const canvas = document.getElementById('fields-canvas');
		const labelsContainer = document.getElementById('fields-labels');
		if (!(canvas instanceof HTMLCanvasElement) || !pinSection) return;

		const dataEl = document.getElementById('fields-data');
		const timelineCompleta: FieldYear[] = dataEl ? JSON.parse(dataEl.textContent ?? '[]') : [];

		const dizEl = document.getElementById('fields-tag-dizionario');
		const dizionario: DizionarioTag = dizEl ? JSON.parse(dizEl.textContent ?? '{}') : {};

		const strato = document.getElementById('fields-tag-layer');
		const barra = document.getElementById('fields-tag-bar');
		const pulsante = document.getElementById('fields-tag-toggle');
		const conteggio = document.getElementById('fields-tag-conteggio');
		const annoWatermark = document.getElementById('fields-anno-watermark');
		const testi = document.getElementById('fields-tag-testi');

		const hrefVoce = (id: string) => (lingua === 'it' ? `/it/fields/${id}` : `/fields/${id}`);

		function costruisci(tagAttivi: string[]) {
			const timeline = filtraTimeline(timelineCompleta, tagAttivi);
			const marker = timeline.flatMap((anno) => anno.markers);

			// Un solo risultato non è una spirale: si va dritti all'articolo,
			// e i tag spariscono dall'URL prima di partire — così il ritorno
			// col tasto indietro riapre Fields nella sua forma di sempre.
			if (tagAttivi.length > 0 && marker.length === 1) {
				history.replaceState({ tag: [] }, '', urlConTag([]));
				navigate(hrefVoce(marker[0].id));
				return;
			}

			if (conteggio) conteggio.textContent = tagAttivi.length > 0 ? String(marker.length) : '';

			spiralHandle?.destroy();
			spiralHandle = initFieldsSpiral({
				canvas: canvas as HTMLCanvasElement,
				pinSection: pinSection as HTMLElement,
				labelsContainer: labelsContainer ?? undefined,
				timeline,
				onFocusMarker: (fuoco) => filtro?.aggiornaFuoco(fuoco),
				onYear: (tf) => {
					if (!annoWatermark) return;
					if (tf == null) {
						delete annoWatermark.dataset.visibile;
						gsap.to(annoWatermark, { opacity: 0, duration: 0.4, ease: 'power2.out' });
						return;
					}

					const i = Math.min(timeline.length - 1, Math.floor(tf));
					const frac = tf - i;
					// L'anno resta fermo per quasi tutto il giro; solo nell'ultimo
					// tratto il giro seguente lo scalza, 1:1 con lo scroll — come
					// il watermark sticky delle Pubblicazioni.
					const SOGLIA = 0.8;
					const spinta = frac <= SOGLIA ? 0 : (frac - SOGLIA) / (1 - SOGLIA);

					let corrente = annoWatermark.children[0] as HTMLElement | undefined;
					let successivo = annoWatermark.children[1] as HTMLElement | undefined;
					if (!corrente) {
						corrente = document.createElement('span');
						corrente.className = 'absolute inset-x-0 top-0 block whitespace-nowrap will-change-transform';
						annoWatermark.appendChild(corrente);
					}
					if (!successivo) {
						successivo = document.createElement('span');
						successivo.className = 'absolute inset-x-0 top-0 block whitespace-nowrap will-change-transform';
						annoWatermark.appendChild(successivo);
					}

					corrente.textContent = String(timeline[i].year);
					corrente.style.transform = `translateY(${(-spinta * 100).toFixed(2)}%)`;

					const annoVecchio = timeline[i + 1]?.year;
					if (annoVecchio != null) {
						successivo.textContent = String(annoVecchio);
						successivo.style.transform = `translateY(${(100 - spinta * 100).toFixed(2)}%)`;
						successivo.style.display = '';
					} else {
						successivo.style.display = 'none';
					}

					// Prima comparsa: dissolvenza lenta, in coppia con l'intro
					// (spirale che si avvita / flythrough della corda). Gli
					// aggiornamenti successivi non ritoccano l'opacità.
					if (!annoWatermark.dataset.visibile) {
						annoWatermark.dataset.visibile = '1';
						gsap.to(annoWatermark, { opacity: 1, duration: 1.2, ease: 'power2.out' });
					}
				},
				onOpenMarker: async (marker, playZoom) => {
					sessionStorage.setItem('fields-target-marker', marker.id);
					const overlay = document.getElementById('field-transition-overlay');
					const fadeIn = overlay
						? gsap.to(overlay, {
								opacity: 1,
								duration: OPEN_ZOOM_DURATION_MS / 1000,
								ease: 'power2.in',
							})
						: null;
					await Promise.all([playZoom(), fadeIn?.then(() => {})]);
					navigate(hrefVoce(marker.id));
				},
			});
		}

		/** Ricostruzione visibile: la scena sfuma, si rifà, rientra con la sua intro. */
		function ricostruisci(tagAttivi: string[]) {
			window.scrollTo(0, 0);
			gsap.to(pinSection, {
				opacity: 0,
				duration: 0.2,
				ease: 'power2.in',
				onComplete: () => {
					costruisci(tagAttivi);
					gsap.to(pinSection, { opacity: 1, duration: 0.35, ease: 'power2.out' });
				},
			});
		}

		if (strato && barra && pulsante instanceof HTMLButtonElement) {
			pulsante.classList.remove('hidden');
			pulsante.classList.add('flex');
			filtro = creaFiltroTag({
				contenitore: strato,
				pulsante,
				barra,
				dizionario,
				etichettaRimuovi: testi?.dataset.rimuovi ?? 'Remove tag',
				onCambio: ricostruisci,
			});
		}

		costruisci(leggiTagAttivi());
	}

	if (document.getElementById('fields-pin') || document.getElementById('fields-list')) {
		setup();
	}

	document.addEventListener('astro:page-load', setup);
	document.addEventListener('astro:before-swap', cleanup);
</script>
