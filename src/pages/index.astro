---
import '../styles/global.css';
import { identita, sezioni } from '../data/home';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{identita.nome}</title>
	</head>
	<body class="bg-paper text-ink font-sans">
		<Nav />

		<div
			id="section-counter"
			class="pointer-events-none fixed inset-x-0 top-[calc(50dvh-7vw-3.75rem)] z-20 flex justify-center text-xs uppercase tracking-widest opacity-0 sm:inset-x-auto sm:left-10 sm:top-1/2 sm:block sm:-translate-y-1/2"
			aria-hidden="true"
		>
			<span class="flex items-center gap-1 rounded-full bg-paper/80 px-3 py-1 tabular-nums backdrop-blur-sm">
				<span id="section-counter-mask" class="relative inline-block h-[1em] w-[2ch] overflow-hidden align-middle">
					<span class="section-counter-digit absolute inset-0 flex items-center justify-center tracking-normal">01</span>
				</span>
				<span>/ {String(sezioni.length).padStart(2, '0')}</span>
			</span>
		</div>

		<div id="title-overlay" class="pointer-events-none fixed inset-0 z-10 flex flex-col items-center justify-center px-6 text-center" aria-hidden="true">
			<p id="title-overlay-role" class="mb-4 text-xs uppercase tracking-widest transition-opacity duration-300 sm:text-sm" style="opacity: 0">{identita.ruolo}</p>
			<div id="title-overlay-inner" class="font-display leading-[0.95] flex flex-wrap items-center justify-center text-[12vw] sm:text-[8vw]"></div>
			<p id="title-overlay-affiliazione" class="mt-4 text-xs uppercase tracking-widest transition-opacity duration-300 sm:text-sm" style="opacity: 0">{identita.affiliazione}</p>
		</div>

		<main id="scroll-container" class="h-dvh snap-y snap-mandatory overflow-y-scroll scroll-smooth">
			<section class="relative z-0 flex h-dvh snap-start flex-col items-center justify-center px-6 text-center">
				<svg data-pattern-bg class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-0" aria-hidden="true"></svg>
				<p class="mb-4 text-xs uppercase tracking-widest opacity-0 sm:text-sm">{identita.ruolo}</p>
				<h1 class="font-display text-[12vw] leading-[0.95] opacity-0 sm:text-[8vw]">{identita.nome}</h1>
				<p class="mt-4 text-xs uppercase tracking-widest opacity-0 sm:text-sm">{identita.affiliazione}</p>
			</section>

			{sezioni.map((s, i) => (
				<a
					href={s.href}
					class="group relative z-0 flex h-dvh snap-start flex-col items-center justify-center gap-6 px-6 text-center"
					aria-label={`Vai a ${s.titolo}`}
				>
					<svg data-pattern-bg class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-0" aria-hidden="true"></svg>
					<h2 class="font-display text-[14vw] leading-[0.95] opacity-0 sm:text-[9vw]">{s.titolo}</h2>
					<span
						id={`scroll-arrow-${i + 1}`}
						class="scroll-arrow pointer-events-none fixed inset-x-0 top-[calc(50dvh+7vw+2rem)] z-10 text-center text-2xl opacity-0 transition-opacity duration-200 group-hover:opacity-60 group-focus-visible:opacity-60 sm:top-[calc(50dvh+4.5vw+2rem)]"
						aria-hidden="true"
					>↓</span>
				</a>
			))}
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { initSectionPatterns } from '../scripts/section-patterns';
	import { initSectionMorph } from '../scripts/section-morph';

	gsap.registerPlugin(ScrollTrigger);

	// Non bloccante: titolo/nav sono già interattivi, gli sfondi-pattern
	// si calcolano ora e compaiono in dissolvenza quando pronti (vedi
	// sessione /grill-me in docs/brain/design.md). Il morphing tra
	// sezioni ha bisogno delle icone già piazzate per leggerne la
	// posizione reale, quindi parte solo a fetch/parse completato.
	initSectionPatterns().then(() => initSectionMorph());

	// Bucket/viewBox degli sfondi e trasformazioni px del morph sono
	// calcolati una volta sulle dimensioni della finestra al setup: un
	// resize li lascia stale (icone che atterrano nel punto sbagliato).
	// Reinizializzazione completa, con debounce per non rifare il fetch
	// a ogni pixel durante il trascinamento del bordo finestra.
	let resizeTimeout: ReturnType<typeof setTimeout>;
	window.addEventListener('resize', () => {
		clearTimeout(resizeTimeout);
		resizeTimeout = setTimeout(() => {
			initSectionPatterns().then(() => initSectionMorph());
		}, 200);
	});

	const scroller = document.getElementById('scroll-container');
	const badge = document.getElementById('section-counter');
	const mask = document.getElementById('section-counter-mask');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (scroller && badge && mask) {
		let current = mask.querySelector<HTMLElement>('.section-counter-digit');

		const setDigit = (value: string, direction: 1 | -1) => {
			if (current?.textContent === value) return;

			if (prefersReducedMotion) {
				if (current) {
					current.textContent = value;
				}
				return;
			}

			const incoming = document.createElement('span');
			incoming.className = 'section-counter-digit absolute inset-0 flex items-center justify-center tracking-normal';
			incoming.textContent = value;
			gsap.set(incoming, { yPercent: direction === 1 ? 100 : -100 });
			mask.appendChild(incoming);

			const outgoing = current;
			const tl = gsap.timeline({
				defaults: { duration: 0.5, ease: 'power3.inOut' },
				onComplete: () => outgoing?.remove(),
			});
			if (outgoing) tl.to(outgoing, { yPercent: direction === 1 ? -100 : 100 }, 0);
			tl.to(incoming, { yPercent: 0 }, 0);

			current = incoming;
		};

		const showBadge = (show: boolean) => {
			gsap.to(badge, { opacity: show ? 1 : 0, duration: 0.3, overwrite: true });
		};

		const sections = Array.from(scroller.children) as HTMLElement[];

		sections.forEach((el, i) => {
			if (i === 0) {
				ScrollTrigger.create({
					trigger: el,
					scroller,
					start: 'top top',
					end: 'bottom top',
					onLeave: () => showBadge(true),
					onEnterBack: () => showBadge(false),
				});
				return;
			}

			const value = String(i).padStart(2, '0');
			ScrollTrigger.create({
				trigger: el,
				scroller,
				start: 'top center',
				end: 'bottom center',
				onEnter: () => setDigit(value, 1),
				onEnterBack: () => setDigit(value, -1),
			});
		});
	}

	const overlayInner = document.getElementById('title-overlay-inner');
	const overlayRole = document.getElementById('title-overlay-role');
	const overlayAffiliazione = document.getElementById('title-overlay-affiliazione');

	if (scroller && overlayInner) {
		type Fragment = { text: string; role: 'up' | 'down' };
		type Step = { fragments: Fragment[]; spaced: boolean; hero: boolean };

		const HERO_SIZE = ['text-[12vw]', 'sm:text-[8vw]'];
		const SECTION_SIZE = ['text-[14vw]', 'sm:text-[9vw]'];
		const GAP = 'gap-x-[0.2em]';

		const splitStep = (title: string, hero: boolean): Step => {
			const words = title.trim().split(/\s+/);
			const parts = words.length > 1 ? words : (() => {
				const mid = Math.floor(title.length / 2);
				return [title.slice(0, mid), title.slice(mid)];
			})();
			return {
				hero,
				spaced: words.length > 1,
				fragments: parts.map((text, i) => ({ text, role: i % 2 === 0 ? 'up' : 'down' })),
			};
		};

		const sectionsForTitle = Array.from(scroller.children) as HTMLElement[];
		const steps: Step[] = sectionsForTitle.map((el, i) =>
			splitStep(el.querySelector('h1, h2')?.textContent?.trim() ?? '', i === 0)
		);

		const applyChrome = (step: Step) => {
			overlayInner.classList.remove(...HERO_SIZE, ...SECTION_SIZE, GAP);
			overlayInner.classList.add(...(step.hero ? HERO_SIZE : SECTION_SIZE));
			if (step.spaced) overlayInner.classList.add(GAP);
			if (overlayRole) overlayRole.style.opacity = step.hero ? '0.6' : '0';
			if (overlayAffiliazione) overlayAffiliazione.style.opacity = step.hero ? '0.6' : '0';
		};

		const buildFragmentEls = (step: Step) => {
			overlayInner.innerHTML = '';
			return step.fragments.map(({ text }) => {
				const span = document.createElement('span');
				span.className = 'inline-block';
				span.textContent = text;
				overlayInner.appendChild(span);
				return span;
			});
		};

		// direction===1: forward (down) scroll. A fragment's own up/down role
		// flips this into the counter's enter/exit convention (see setDigit above).
		const effDirection = (role: Fragment['role'], direction: 1 | -1) =>
			(role === 'up' ? direction : -direction) as 1 | -1;

		const renderInstant = (index: number) => {
			const step = steps[index];
			applyChrome(step);
			buildFragmentEls(step);
		};

		let currentTitleIndex = 0;
		renderInstant(0);

		const enterStep = (index: number, direction: 1 | -1) => {
			const step = steps[index];
			applyChrome(step);
			const els = buildFragmentEls(step);
			els.forEach((el, i) => {
				const eff = effDirection(step.fragments[i].role, direction);
				gsap.fromTo(
					el,
					{ yPercent: eff === 1 ? 120 : -120, opacity: 0 },
					{ yPercent: 0, opacity: 1, duration: 0.45, ease: 'power3.out' }
				);
			});
		};

		const goToTitleStep = (index: number, direction: 1 | -1) => {
			if (index === currentTitleIndex) return;
			const fromIndex = currentTitleIndex;
			currentTitleIndex = index;

			if (prefersReducedMotion) {
				renderInstant(index);
				return;
			}

			const fromStep = steps[fromIndex];
			const outgoing = Array.from(overlayInner.children) as HTMLElement[];
			const tl = gsap.timeline({
				defaults: { duration: 0.45, ease: 'power3.in' },
				onComplete: () => enterStep(index, direction),
			});
			outgoing.forEach((el, i) => {
				const eff = effDirection(fromStep.fragments[i].role, direction);
				tl.to(el, { yPercent: eff === 1 ? -120 : 120, opacity: 0 }, 0);
			});
		};

		sectionsForTitle.forEach((el, i) => {
			if (i === 0) {
				ScrollTrigger.create({
					trigger: el,
					scroller,
					start: 'top top',
					end: 'bottom top',
					onEnterBack: () => goToTitleStep(0, -1),
				});
				return;
			}

			ScrollTrigger.create({
				trigger: el,
				scroller,
				start: 'top center',
				end: 'bottom center',
				onEnter: () => goToTitleStep(i, 1),
				onEnterBack: () => goToTitleStep(i, -1),
			});
		});
	}

	const arrows = Array.from(document.querySelectorAll<HTMLElement>('.scroll-arrow'));

	if (scroller && arrows.length > 0) {
		let activeArrow: HTMLElement | null = null;
		let pendingArrow: HTMLElement | null = null;
		let arrowResting = true;
		let offsetY = 0;
		const MAX_TRAVEL_DOWN = () => window.innerHeight * 0.22;
		const MAX_TRAVEL_UP = () => window.innerHeight * 0.22 + 60;

		const arrowSections = Array.from(scroller.children) as HTMLElement[];
		arrowSections.forEach((el, i) => {
			if (i === 0) return;
			const arrow = document.getElementById(`scroll-arrow-${i}`);
			if (!arrow) return;
			const setActiveArrow = () => {
				if (activeArrow === arrow) return;
				if (arrowResting) {
					activeArrow = arrow;
					pendingArrow = null;
				} else {
					pendingArrow = arrow;
				}
			};
			ScrollTrigger.create({
				trigger: el,
				scroller,
				start: 'top center',
				end: 'bottom center',
				onEnter: setActiveArrow,
				onEnterBack: setActiveArrow,
			});
		});

		if (!prefersReducedMotion) {
			const moveY = gsap.quickTo(arrows, 'y', { duration: 0.35, ease: 'power3.out' });
			const rotate = gsap.quickTo(arrows, 'rotation', { duration: 0.35, ease: 'power3.out' });
			let lastScrollTop = scroller.scrollTop;
			let settleTimeout: ReturnType<typeof setTimeout>;

			scroller.addEventListener('scroll', () => {
				if (!activeArrow) return;

				const scrollTop = scroller.scrollTop;
				const delta = scrollTop - lastScrollTop;
				lastScrollTop = scrollTop;

				offsetY = gsap.utils.clamp(-MAX_TRAVEL_UP(), MAX_TRAVEL_DOWN(), offsetY + delta);
				moveY(offsetY);
				const ROTATE_THRESHOLD = 4;
				if (offsetY > ROTATE_THRESHOLD) rotate(0);
				else if (offsetY < -ROTATE_THRESHOLD) rotate(180);
				arrowResting = false;
				gsap.to(activeArrow, { opacity: 0.6, duration: 0.2, overwrite: 'auto' });

				clearTimeout(settleTimeout);
				settleTimeout = setTimeout(() => {
					offsetY = 0;
					moveY(0);
					rotate(0);
					const restingArrow = activeArrow;
					gsap.to(restingArrow, {
						opacity: 0,
						duration: 0.3,
						overwrite: 'auto',
						onComplete: () => {
							if (restingArrow) gsap.set(restingArrow, { clearProps: 'opacity' });
							arrowResting = true;
							if (pendingArrow) {
								activeArrow = pendingArrow;
								pendingArrow = null;
							}
						},
					});
				}, 150);
			});
		}
	}
</script>
