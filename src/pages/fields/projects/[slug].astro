---
import { getCollection } from 'astro:content';
import { perLingua } from '../../../lib/contenuti';
import PaginaProjectsDettaglio from '../../../components/PaginaProjectsDettaglio.astro';

export async function getStaticPaths() {
	const entries = perLingua(await getCollection('projects'), 'en');
	return entries.map((entry) => ({ params: { slug: entry.chiave }, props: { entry } }));
}

const { entry } = Astro.props;
---

<PaginaProjectsDettaglio entry={entry} lingua="en" />
