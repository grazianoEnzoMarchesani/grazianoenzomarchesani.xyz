---
import { getCollection } from 'astro:content';
import { perLingua } from '../../../lib/contenuti';
import PaginaTeachingDettaglio from '../../../components/PaginaTeachingDettaglio.astro';

export async function getStaticPaths() {
	const entries = perLingua(await getCollection('teaching'), 'en');
	return entries.map((entry) => ({ params: { slug: entry.chiave }, props: { entry } }));
}

const { entry } = Astro.props;
---

<PaginaTeachingDettaglio entry={entry} lingua="en" />
